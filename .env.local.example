# MongoDB Atlas connection string (from Database Access + "Connect")
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/todaymagazine

# Any long random string — used to sign login sessions
JWT_SECRET=change-this-to-a-long-random-string

# From your Cloudinary dashboard (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Comma-separated list of emails that should automatically become admins
ADMIN_EMAILS=you@example.com

# --- Google Sign-In ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web application)
# Same value goes in both — one is used server-side, one is exposed to the browser
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Email OTP (used to send the 6-digit verification code) ---
# Example values for Gmail: host smtp.gmail.com, port 587, user = your Gmail
# address, pass = a 16-character Gmail "App Password" (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=TodayMagazine <your-email@gmail.com>
